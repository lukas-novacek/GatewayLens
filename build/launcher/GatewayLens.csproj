<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GatewayLens.exe - a small launcher for GatewayLens.ps1.

    .NET Framework 4.8 is part of every Windows 10 and 11 install, so the exe needs
    no runtime of its own. The script is carried inside the exe as a resource,
    unpacked to %LOCALAPPDATA%\GatewayLens\app\<version>\ and started in PowerShell 7.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>GatewayLens</AssemblyName>
    <RootNamespace>GatewayLens.Launcher</RootNamespace>
    <ApplicationIcon>..\..\assets\GatewayLens.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <Product>GatewayLens</Product>
    <Description>Desktop console for on-premises data gateways and their connections</Description>
    <Copyright>MIT License</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- run as 64-bit on 64-bit Windows, so Program Files means Program Files -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\GatewayLens.ps1" LogicalName="GatewayLens.ps1" />
  </ItemGroup>
</Project>
