<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "exe" - see docs/code-signing.md.
  The release workflow uploads GatewayLens.exe alone; GitHub Actions wraps it in a zip.
  product-name makes SignPath refuse any exe that is not GatewayLens.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="GatewayLens.exe" product-name="GatewayLens">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
